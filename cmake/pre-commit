#!/bin/bash
# Pelco-D Controller Git Pre-Commit Hook: Auto-format modified C++ source files using clang-format

CLANG_FORMAT=$(command -v clang-format || command -v clang-format-15 || command -v clang-format-14 || command -v clang-format-12)

if [ -z "$CLANG_FORMAT" ]; then
    echo "[GIT HOOK WARNING] clang-format executable not found in PATH. Skipping formatting check."
    exit 0
fi

# Find all staged C++ source and header files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|c|h|cc|cxx)$')

if [ -n "$STAGED_FILES" ]; then
    echo "[GIT HOOK] Running clang-format on staged C++ files..."
    for FILE in $STAGED_FILES; do
        if [ -f "$FILE" ]; then
            $CLANG_FORMAT -i -style=file "$FILE"
            git add "$FILE"
        fi
    done
    echo "[GIT HOOK] Formatting complete and files re-staged."
fi

exit 0
