/* Modern Military/Industrial Dark Theme for Pelco-D Controller */

QMainWindow, QWidget#centralWidget {
    background-color: #1a1c1e;
    color: #e2e4e7;
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 12px;
}

QTabWidget::pane {
    border: 1px solid #2d3136;
    background-color: #202327;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #1a1c1e;
    color: #9aa0a6;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #202327;
    color: #4da3ff;
    border-bottom: 2px solid #4da3ff;
}

QTabBar::tab:hover:!selected {
    background-color: #262a2f;
    color: #d1d5db;
}

QGroupBox {
    border: 1px solid #32373e;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 10px;
    background-color: #22262b;
    font-weight: bold;
    color: #8ab4f8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    background-color: #22262b;
}

QPushButton {
    background-color: #2d333b;
    color: #f0f3f6;
    border: 1px solid #444c56;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #373e47;
    border-color: #58a6ff;
}

QPushButton:pressed {
    background-color: #1f242c;
    border-color: #1f6feb;
}

QPushButton:disabled {
    background-color: #1c2128;
    color: #545d68;
    border-color: #2d333b;
}

QPushButton#btnPrimary {
    background-color: #1f6feb;
    border-color: #388bfd;
    color: #ffffff;
}

QPushButton#btnPrimary:hover {
    background-color: #388bfd;
}

QPushButton#btnDanger {
    background-color: #b62324;
    border-color: #da3633;
    color: #ffffff;
}

QPushButton#btnDanger:hover {
    background-color: #da3633;
}

QPushButton#btnDpad {
    background-color: #21262d;
    border: 1px solid #30363d;
    font-size: 14px;
    font-weight: bold;
    min-width: 48px;
    min-height: 48px;
    border-radius: 6px;
}

QPushButton#btnDpad:hover {
    background-color: #30363d;
    border-color: #58a6ff;
}

QPushButton#btnDpad:pressed {
    background-color: #1f6feb;
    color: #ffffff;
}

QSlider::groove:horizontal {
    border: 1px solid #373e47;
    height: 6px;
    background: #161b22;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #1f6feb;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #58a6ff;
    border: 1px solid #ffffff;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #79c0ff;
}

QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit, QTimeEdit {
    background-color: #161b22;
    border: 1px solid #373e47;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e6edf3;
    min-height: 20px;
}

QComboBox:hover, QSpinBox:hover, QLineEdit:hover {
    border-color: #58a6ff;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #373e47;
}

QComboBox QAbstractItemView {
    background-color: #1c2128;
    color: #e6edf3;
    selection-background-color: #1f6feb;
    border: 1px solid #373e47;
}

QTableWidget {
    background-color: #161b22;
    alternate-background-color: #1c2128;
    border: 1px solid #30363d;
    gridline-color: #21262d;
    color: #e6edf3;
    font-family: "Courier New", monospace;
    font-size: 11px;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QTableWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}


QHeaderView::section {
    background-color: #21262d;
    color: #8b949e;
    padding: 4px;
    border: 1px solid #30363d;
    font-weight: bold;
}

QLabel {
    color: #c9d1d9;
}

QLabel#lblTelemetry {
    font-family: "Courier New", monospace;
    font-size: 13px;
    font-weight: bold;
    color: #58a6ff;
    background-color: #161b22;
    padding: 3px 6px;
    border-radius: 3px;
    border: 1px solid #30363d;
}

QCheckBox {
    color: #c9d1d9;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #484f58;
    border-radius: 3px;
    background-color: #161b22;
}

QCheckBox::indicator:checked {
    background-color: #1f6feb;
    border-color: #58a6ff;
}

QStatusBar {
    background-color: #161b22;
    color: #8b949e;
    border-top: 1px solid #30363d;
}
