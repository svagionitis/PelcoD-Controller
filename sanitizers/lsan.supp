# ==============================================================================
# Pelco-D Controller - LeakSanitizer (LSan) Suppressions
#
# Guidelines:
# 1. Suppressions are STRICTLY PROHIBITED for any symbols within libs/Onvif/
#    or libs/PelcoDCore/.
# 2. Every suppression must target third-party runtime or OS-level allocations
#    and include a rationale.
# ==============================================================================

# OpenSSL one-time global crypto library initialization
leak:OPENSSL_init_crypto
leak:ossl_init_base
leak:OPENSSL_init_ssl
leak:CRYPTO_zalloc
leak:CRYPTO_malloc
leak:provider_init

# glibc / libdl dynamic loading and thread-local storage allocation
leak:dlerror_run
leak:_dl_allocate_tls
leak:pthread_create

# GoogleTest internal leak false-positives during static test case registration
leak:testing::internal::UnitTestImpl
leak:testing::InitGoogleTest
leak:testing::Test::SetUp
