# ==============================================================================
# Pelco-D Controller - ThreadSanitizer (TSan) Suppressions
#
# Guidelines:
# 1. Suppressions are STRICTLY PROHIBITED for any symbols within libs/Onvif/
#    or libs/PelcoDCore/.
# 2. Every suppression must target third-party runtime or OS-level allocations
#    and include a rationale.
# ==============================================================================

# OpenSSL internal PRNG and entropy pool synchronization
race:drbg_ctr_init
race:RAND_bytes
race:ossl_rand_pool_bytes_needed

# glibc dynamic loader thread synchronization
race:_dl_allocate_tls_storage
race:_dl_deallocate_tls

# GoogleTest death-test fork signal handler
race:testing::internal::DeathTest
